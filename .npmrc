# Esta plataforma se construye en Cloudflare Builds, donde NO existe el
# ~/.npmrc de nadie. Si aqui no se fija nada, npm usa la configuracion global
# del equipo que instala, y eso ya costo un despliegue roto: el `.npmrc` del
# usuario tenia `legacy-peer-deps=true`, que apaga la comprobacion de peer
# dependencies. En local todo pasaba; en Cloudflare, `npm ci` fallaba con
# «package.json and package-lock.json are not in sync» y una lista de paquetes
# que aqui nadie veia.
#
# Con esto en el repositorio, el equipo de trabajo y el contenedor de
# construccion resuelven el arbol igual, y un conflicto de peers se ve el dia
# que se introduce y no el dia del despliegue.
legacy-peer-deps=false